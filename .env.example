# 복사해서 .env 로 사용 (uv run --env-file .env ...)

# 네이버 쇼핑 검색 API (https://developers.naver.com → 애플리케이션 등록 → 검색 API)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 알리익스프레스 Affiliate API (https://portals.aliexpress.com → App 등록)
ALI_APP_KEY=
ALI_APP_SECRET=
ALI_TRACKING_ID=

# 알림 (선택)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# 기타
USD_KRW=1400
COLLECT_INTERVAL_SEC=300
PRICE_CHECK_INTERVAL_SEC=3600
# 비우면 기본 소스 사용. 예: ppomppu,ppomppu8,clien,quasarzone
ENABLED_SOURCES=
# HOTDEAL_DB=data/hotdeal.db

# --- AI 최저가 탐색 (Claude API + 웹 검색) ---
# https://platform.claude.com 에서 API 키 발급. 웹 검색은 1,000회당 $10 + 토큰 비용.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=high
AI_MAX_SEARCHES=8
AI_MAX_FETCHES=10
AI_DAILY_BUDGET_USD=2.0
AI_RUN_RESERVE_USD=1.0
AI_RUN_MAX_USD=1.5
AI_RUN_TIMEOUT_SEC=600
# 추적 상품 '매일 AI 조사' 시작 시각 (한국 시간)
AI_DAILY_HOUR=9
# 1이면 동적 필터링 없이 검색 결과를 직접 받음 (인용이 적게 나오면 시도)
AI_SEARCH_DIRECT=0
