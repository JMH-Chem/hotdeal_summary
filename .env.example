# 복사해서 .env 로 사용 (uv run --env-file .env ...)

# 네이버 쇼핑 검색 API (https://developers.naver.com → 애플리케이션 등록 → 검색 API)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 알리익스프레스 Affiliate API (https://portals.aliexpress.com → App 등록)
ALI_APP_KEY=
ALI_APP_SECRET=
ALI_TRACKING_ID=

# 알림 (선택)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# 기타
USD_KRW=1400
COLLECT_INTERVAL_SEC=300
PRICE_CHECK_INTERVAL_SEC=3600
# 비우면 기본 소스 사용. 예: ppomppu,ppomppu8,clien,quasarzone
ENABLED_SOURCES=
# HOTDEAL_DB=data/hotdeal.db
